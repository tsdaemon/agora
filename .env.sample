# Copy to .env (gitignored). Loaded by Taskfile (dotenv) and by the app (AGORA_* variables).

# Public hostname of the server (no scheme, no path). Served over HTTPS; ChatGPT connects to
# https://<this>/mcp. It is also the expected token audience and the Traefik/tunnel hostname.
AGORA_PUBLIC_HOST=agora.example.com

# Keycloak realm issuer. Must equal the `iss` claim exactly.
AGORA_OAUTH_ISSUER=https://keycloak.example.com/realms/home

# Keycloak user ID (`sub`) of the one allowed user. Keycloak admin console -> realm home -> Users.
AGORA_OWNER_SUBJECT=

# Optional: expected `aud` (defaults to https://AGORA_PUBLIC_HOST, which is what the agora-audience scope sets).
# AGORA_AUDIENCE=

# Optional: extra accepted Host headers, JSON list (e.g. to call /mcp on localhost while developing).
# AGORA_EXTRA_ALLOWED_HOSTS=["localhost:6492"]

# Listen address/port inside the container or dev process.
AGORA_PORT=6492
